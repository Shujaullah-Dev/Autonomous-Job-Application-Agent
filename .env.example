# Application
APP_NAME=AI Job Agent
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_DB=ai_job_agent
POSTGRES_USER=ai_job_agent
POSTGRES_PASSWORD=change_me

# Database — Supabase PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change_me

# LLM
LLM_PROVIDER=local
LLM_MODEL=

# Optional hosted LLM
# LLM_API_KEY=
# LLM_BASE_URL=

# Frontend
FRONTEND_URL=http://localhost:3000

# Notifications
EMAIL_PROVIDER=mock

# Calendar
CALENDAR_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RESUME_AI_ENABLED=true
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_CHARS=20000

DEV_JOB_WRITE_KEY=

# Job source settings
JOB_SOURCE_TIMEOUT_SECONDS=20

# LangChain explanations
LANGCHAIN_EXPLANATIONS_ENABLED=false

# Disable optional external LangSmith tracing for local development
LANGSMITH_TRACING=false

# Application drafts
APPLICATION_DRAFTS_AI_ENABLED=false

# Docker local deployment
# Host-side port: only accessible on 127.0.0.1
HOST_API_PORT=8000

# These remain supplied by the actual .env file:
# DATABASE_URL=postgresql+psycopg://...
# DEV_JOB_WRITE_KEY=...

# Docker Compose sets:
# APP_ENV=development
# DEBUG=false
# CONTAINERIZED=1