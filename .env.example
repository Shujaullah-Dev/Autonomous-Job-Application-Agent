# Application
APP_NAME=AI Job Agent
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_DB=ai_job_agent
POSTGRES_USER=ai_job_agent
POSTGRES_PASSWORD=change_me

# Database — Supabase PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change_me

# LLM
LLM_PROVIDER=local
LLM_MODEL=

# Optional hosted LLM
# LLM_API_KEY=
# LLM_BASE_URL=

# Frontend
FRONTEND_URL=http://localhost:3000

# Notifications
EMAIL_PROVIDER=mock

# Calendar
CALENDAR_PROVIDER=mock